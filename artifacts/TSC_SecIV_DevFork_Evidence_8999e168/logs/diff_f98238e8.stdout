diff --git a/Experiment/BPMNwithDMNcase/new/Blood_analysis.dmn b/Experiment/BPMNwithDMNcase/new/Blood_analysis.dmn
new file mode 100644
index 00000000..4519a45f
--- /dev/null
+++ b/Experiment/BPMNwithDMNcase/new/Blood_analysis.dmn
@@ -0,0 +1,44 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="definitions_1olsuce" name="definitions" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.22.0">
+  <decision id="decision_0tybghz" name="blood">
+    <decisionTable id="decisionTable_1v3tii8" hitPolicy="FIRST">
+      <input id="input1" label="result">
+        <inputExpression id="inputExpression1" typeRef="string">
+          <text>result</text>
+        </inputExpression>
+      </input>
+      <output id="output1" label="FurtherCheck" name="FurtherCheck" typeRef="boolean" biodi:width="192" />
+      <rule id="DecisionRule_12ud8g3">
+        <inputEntry id="UnaryTests_1m2j1vk">
+          <text>"healthy"</text>
+        </inputEntry>
+        <outputEntry id="LiteralExpression_1kynia0">
+          <text>false</text>
+        </outputEntry>
+      </rule>
+      <rule id="DecisionRule_1crblss">
+        <inputEntry id="UnaryTests_0fq1t5q">
+          <text>"ill"</text>
+        </inputEntry>
+        <outputEntry id="LiteralExpression_0o6wt1c">
+          <text>true</text>
+        </outputEntry>
+      </rule>
+      <rule id="DecisionRule_0xxkxsz">
+        <inputEntry id="UnaryTests_1lbv57k">
+          <text>"uncertain"</text>
+        </inputEntry>
+        <outputEntry id="LiteralExpression_1az0uw1">
+          <text>true</text>
+        </outputEntry>
+      </rule>
+    </decisionTable>
+  </decision>
+  <dmndi:DMNDI>
+    <dmndi:DMNDiagram id="DMNDiagram_1ie0d19">
+      <dmndi:DMNShape id="DMNShape_1r1kqcr" dmnElementRef="decision_0tybghz">
+        <dc:Bounds height="80" width="180" x="150" y="150" />
+      </dmndi:DMNShape>
+    </dmndi:DMNDiagram>
+  </dmndi:DMNDI>
+</definitions>
