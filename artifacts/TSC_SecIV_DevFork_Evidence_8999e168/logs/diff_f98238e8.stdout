+      <abc:MessageSchema>
+        <abc:Property name="confirmation" type="boolean" description="Whether to accept the service plan" required="true" definition="{&quot;type&quot;:&quot;boolean&quot;,&quot;description&quot;:&quot;Whether to accept the service plan&quot;}" />
+      </abc:MessageSchema>
+    </bpmn2:extensionElements>
