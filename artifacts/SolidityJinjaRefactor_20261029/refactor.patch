@@ -0,0 +1,41 @@
+contract FlowTemplateRegression {
+ participants { participant Sender {} participant Receiver {} }
+ globals { Count: int Flag: bool Label: string Ratio: float }
+ messages {
+  message MessageFields from Sender to Receiver { initial state READY schema '{"properties":{"count":{"type":"number"},"flag":{"type":"boolean"},"label":{"type":"string"},"instanceId":{"type":"string"},"1field":{"type":"number"}},"files":{"receipt":{}}}' }
+  message MessageEmpty from Sender to Receiver {}
+ }
+ gateways {
+  gateway Choice { type exclusive }
+  gateway ChoiceBool { type exclusive }
+  gateway ChoiceInt { type exclusive }
+  gateway Join { type parallel }
+  gateway EmptyGateway { type event }
+ }
+ events { event Start { initial state READY } event End {} event EmptyEnd {} }
+ businessrules {
+  businessrule Rule { dmn 'test-only.dmn' decision 'test-only' input mapping { count -> Count flag -> Flag label -> Label } output mapping { resultCount -> Count resultFlag -> Flag resultLabel -> Label } }
+ }
+ oracletasks {
+  oracletask Feed { type external-data dataSource 'test-only://data' output mapping { count -> Count flag -> Flag label -> Label ratio -> Ratio } }
+  oracletask Compute { type compute-task computeScript 'test-only script' output mapping { count -> Count flag -> Flag label -> Label } }
+  oracletask EmptyOracle { type external-data }
+ }
+ flows {
+  start event Start enables MessageFields;
+  when message MessageFields sent then enable Choice, set Count = 1;
+  when message MessageFields completed then enable Choice, disable MessageEmpty;
+  when gateway Choice completed choose {
+   if Label == 'High' then enable Feed;
+   if Label != 'Low' then enable Compute;
+   else then enable EmptyOracle;
+  }
+  when gateway ChoiceBool completed choose { if Flag == true then enable Rule; else then enable End; }
+  when gateway ChoiceInt completed choose { if Count >= 10 then set Label = 'large'; else then set Flag = false; }
+  parallel gateway Join await MessageFields, Choice, End, Rule, Feed then enable EmptyEnd;
+  when oracletask Feed done then enable Compute;
+  when oracletask Compute done then enable Rule;
+  when businessrule Rule done then enable Join;
+  when event End completed then enable EmptyEnd;
+ }
+}
