        Instance storage inst = _getInstance(instanceId);
        ActionEvent storage ev = inst.events[EventKey.{{ task_name }}];
        require(ev.exists, "oracle task not set");
        require(ev.state == ElementState.ENABLED, "oracle task state not allowed");

{{ output_assignments }}        ev.state = ElementState.COMPLETED;
        emit ActionEventDone(instanceId, EventKey.{{ task_name }});
{{ after_hooks }}
    }
